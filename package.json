{
  "name": "secure-donations-2026",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de Donaciones Seguras (proyecto académico, donaciones simuladas)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:contract": "npm run test:contract --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "check-deps": "node scripts/check-deps.mjs",
    "seed": "tsx scripts/seed.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "deploy:frontend": "tsx scripts/deploy-frontend.ts",
    "validate:template": "python scripts/validate-template.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
