# Plantilla de variables de entorno. Copie a `.env` (ignorado por git) y complete SOLO con valores
# de su stage de pruebas. NUNCA guarde aquí secretos, tokens, credenciales de AWS ni datos personales.
# El frontend solo lee las variables con prefijo VITE_ (son públicas: terminan en el bundle).

# --- Frontend (públicas) ---
# URL base de la API (salida de la pila SAM)
VITE_API_BASE_URL=
# Autoridad OIDC del User Pool de Cognito, p. ej. https://cognito-idp.us-east-1.amazonaws.com/<userPoolId>
VITE_OIDC_AUTHORITY=
# Client ID del app client (cliente público, sin secreto; Authorization Code + PKCE)
VITE_OIDC_CLIENT_ID=
# URI de redirección tras el login y tras el logout
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_LOGOUT_URI=http://localhost:5173/
# Dominio de Cognito Hosted UI (sin esquema)
VITE_OIDC_COGNITO_DOMAIN=

# --- Backend / scripts locales (en Lambda las define la plantilla SAM) ---
# academic | dev
STAGE=academic
AWS_REGION=us-east-1
