# ==============================================================================
# Plataforma de Donaciones Seguras AQP-SOLIDARIA
# Variables de entorno de referencia (NO contiene secretos ni credenciales reales)
# ==============================================================================

# General
STAGE=academic
AWS_REGION=us-east-1

# Frontend (Vite)
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=auth-donaciones-aqp.auth.us-east-1.amazoncognito.com
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_LOGOUT_URI=http://localhost:5173/

# Backend (Injected via AWS Lambda Environment in infra/template.yaml)
PROJECTS_TABLE_NAME=Projects-academic
DONATIONS_TABLE_NAME=Donations-academic
IDEMPOTENCY_TABLE_NAME=Idempotency-academic
AUDIT_EVENTS_TABLE_NAME=AuditEvents-academic
ALLOWED_ORIGIN=http://localhost:5173
