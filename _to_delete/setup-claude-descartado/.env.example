# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Este archivo no contiene secretos: solo nombres de variables y valores de ejemplo.

# Región única del proyecto (AWS Free plan)
AWS_REGION=us-east-1
STAGE=academic

# Frontend (Vite) - se completan con las salidas del stack desplegado
VITE_API_BASE_URL=
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
